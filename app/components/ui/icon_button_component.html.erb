<%
  button_classes = [
    "ui-icon-button",
    "ui-icon-button--#{variant}",
    "ui-icon-button--#{size}",
    "ui-icon-button--#{shape}"
  ].join(" ")
%>

<% if link? %>
  <%= link_to href,
              class: button_classes,
              aria: { label: label },
              data: { ui: "icon-button", variant:, size:, shape: } do %>
    <span class="ui-icon-button__icon" aria-hidden="true"><%= content %></span>
  <% end %>
<% else %>
  <%= button_tag type: :button,
                 disabled: disabled,
                 class: button_classes,
                 aria: { label: label },
                 data: { ui: "icon-button", variant:, size:, shape: } do %>
    <span class="ui-icon-button__icon" aria-hidden="true"><%= content %></span>
  <% end %>
<% end %>
