<%
  button_classes = [
    "ui-button",
    "ui-button--#{variant}",
    "ui-button--#{size}"
  ].join(" ")
%>

<% if link? %>
  <%= link_to href, class: button_classes do %>
    <%= content %>
  <% end %>
<% else %>
  <%= button_tag type: :button, class: button_classes do %>
    <%= content %>
  <% end %>
<% end %>
