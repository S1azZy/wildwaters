<section class="ui-flash"
         data-ui="flash"
         data-tone="<%= type %>"
         role="<%= role %>"
         aria-live="<%= live_region_priority %>"
         aria-atomic="true">
  <% if title.present? %>
    <p class="ui-flash__title" data-ui="flash-title"><%= title %></p>
  <% end %>

  <p class="ui-flash__message" data-ui="flash-message"><%= message %></p>
</section>
