<section class="<%= shell_class %>" data-ui="auth-shell" data-variant="<%= variant %>">
  <div class="auth-shell__backdrop" aria-hidden="true">
    <span class="auth-shell__glow auth-shell__glow--one"></span>
    <span class="auth-shell__glow auth-shell__glow--two"></span>
    <span class="auth-shell__grid"></span>
  </div>

  <div class="auth-shell__content">
    <div class="auth-shell__intro">
      <p class="auth-shell__eyebrow"><%= eyebrow %></p>
      <h1 class="auth-shell__title" data-display-text><%= title %></h1>
      <p class="auth-shell__description"><%= description %></p>
    </div>

    <div class="auth-card" data-ui="auth-card">
      <div class="auth-card__header">
        <p class="auth-card__label"><%= panel_label %></p>
      </div>

      <div class="auth-card__body">
        <%= panel %>
      </div>

      <p class="auth-card__alternate">
        <span><%= alternate_prompt %></span>
        <%= link_to alternate_label, alternate_path, class: "auth-card__alternate-link" %>
      </p>
    </div>
  </div>
</section>
