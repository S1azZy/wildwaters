<section class="ui-empty-state" data-ui="empty-state">
  <% if icon? %>
    <div class="ui-empty-state__icon" data-ui="empty-state-icon"><%= icon %></div>
  <% end %>

  <div class="ui-empty-state__body">
    <h2 class="ui-empty-state__title" data-display-text data-ui="empty-state-title"><%= title %></h2>
    <p class="ui-empty-state__copy" data-ui="empty-state-body"><%= body %></p>

    <% if action? %>
      <div class="ui-empty-state__action" data-ui="empty-state-action"><%= action %></div>
    <% end %>
  </div>
</section>
