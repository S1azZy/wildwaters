<header class="site-header-surface sticky top-0 z-50" data-ui="site-header">
  <div class="mx-auto flex w-full max-w-[112rem] flex-col gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <div class="site-header-shell">
      <%= link_to explore_path, class: "site-header-brand group", data: { ui: "site-header-brand" } do %>
        <span class="site-header-badge" aria-hidden="true">
          <span class="site-header-badge-inner">WW</span>
        </span>
        <span class="site-header-brand-copy">
          <span class="site-header-brand-name"><%= brand_name %></span>
          <span class="site-header-brand-tagline" data-ui="site-header-tagline"><%= brand_tagline %></span>
        </span>
      <% end %>

      <nav class="site-header-primary-nav hidden lg:flex" data-ui="site-header-primary-nav" aria-label="Primary">
        <% navigation_items.each do |item| %>
          <% item_classes = [
               "site-header-nav-link",
               ("site-header-nav-link--current" if item.fetch(:current))
             ].compact.join(" ") %>
          <%= link_to item.fetch(:label), item.fetch(:path), class: item_classes, data: { current: item.fetch(:current) } %>
        <% end %>
      </nav>

      <div class="site-header-actions" data-ui="site-header-actions">
        <% session_actions.each do |action| %>
          <% if action[:method].present? %>
            <%= button_to action.fetch(:label),
                          action.fetch(:path),
                          method: action.fetch(:method),
                          form_class: "inline-flex",
                          class: "ui-button ui-button--outlined ui-button--sm site-header-action-control" %>
          <% elsif action.fetch(:key) == :create_account %>
            <%= render Ui::ButtonComponent.new(variant: :primary, size: :sm, href: action.fetch(:path)) do %>
              <%= action.fetch(:label) %>
            <% end %>
          <% else %>
            <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: action.fetch(:path)) do %>
              <%= action.fetch(:label) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <nav class="site-header-mobile-nav lg:hidden" data-ui="site-header-primary-nav" aria-label="Primary">
      <% navigation_items.each do |item| %>
        <% item_classes = [
             "site-header-mobile-link",
             ("site-header-mobile-link--current" if item.fetch(:current))
           ].compact.join(" ") %>
        <%= link_to item.fetch(:label), item.fetch(:path), class: item_classes, data: { current: item.fetch(:current) } %>
      <% end %>
    </nav>
  </div>
</header>
