<% content_for :title, t("auth.sessions.new.title") %>
<% content_for :main_class, "auth-main flex-1 px-0 py-0" %>
<% content_for :body_class, "auth-page auth-page--session" %>

<%
  auth_shell = Ui::AuthShellComponent.new(
    variant: :session,
    eyebrow: t("auth.sessions.new.eyebrow"),
    title: t("auth.sessions.new.heading"),
    description: t("auth.sessions.new.subheading"),
    alternate_prompt: t("auth.sessions.new.sign_up_prompt"),
    alternate_label: t("auth.sessions.new.sign_up_link"),
    alternate_path: new_registration_path,
    footer_author: t("auth.shared.footer.author"),
    footer_note: t("auth.shared.footer.note")
  )
%>

<% auth_shell.with_panel do %>
  <%= form_with url: session_path, scope: :session, class: "space-y-5" do |form| %>
    <div class="auth-form__intro">
      <p class="auth-form__heading"><%= t("auth.sessions.new.card_heading") %></p>
      <p class="auth-form__supporting"><%= t("auth.sessions.new.card_supporting") %></p>
    </div>

    <div class="space-y-1.5">
      <%= form.label :email, t("auth.fields.email"), class: "auth-form__label" %>
      <%= form.email_field :email, value: params.dig(:session, :email), autocomplete: "email", class: "auth-form__input", placeholder: t("auth.fields.email_placeholder") %>
    </div>

    <div class="space-y-1.5">
      <div class="flex items-center justify-between gap-3">
        <%= form.label :password, t("auth.fields.password"), class: "auth-form__label" %>
        <%= link_to t("auth.sessions.new.forgot_password"), new_password_reset_path, class: "auth-form__inline-link" %>
      </div>
      <%= form.password_field :password, autocomplete: "current-password", class: "auth-form__input", placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <%= form.submit t("auth.sessions.new.submit"), class: "auth-form__submit" %>
  <% end %>
<% end %>

<%= render auth_shell %>
