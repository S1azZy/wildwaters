<% content_for :title, t("auth.sessions.new.title") %>

<div class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold"><%= t("auth.sessions.new.heading") %></h1>
  <p class="mt-2 text-sm text-slate-600"><%= t("auth.sessions.new.subheading") %></p>

  <%= form_with url: session_path, scope: :session, class: "mt-8 space-y-4" do |form| %>
    <div>
      <%= form.label :email, t("auth.fields.email"), class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, value: params.dig(:session, :email), autocomplete: "email", class: "w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password, t("auth.fields.password"), class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password, autocomplete: "current-password", class: "w-full rounded border px-3 py-2" %>
    </div>

    <p class="text-sm text-slate-600">
      <%= link_to t("auth.sessions.new.forgot_password"), new_password_reset_path, class: "font-medium text-slate-900 underline" %>
    </p>

    <%= form.submit t("auth.sessions.new.submit"), class: "w-full rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <p class="mt-4 text-sm text-slate-600">
    <%= t("auth.sessions.new.sign_up_prompt") %>
    <%= link_to t("auth.sessions.new.sign_up_link"), new_registration_path, class: "font-medium text-slate-900 underline" %>
  </p>
</div>
