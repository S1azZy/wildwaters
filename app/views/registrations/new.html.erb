<% content_for :title, t("auth.registrations.new.title") %>
<% content_for :main_class, "auth-main flex-1 px-0 py-0" %>
<% content_for :body_class, "auth-page auth-page--registration" %>

<%
  auth_shell = Ui::AuthShellComponent.new(
    variant: :registration,
    eyebrow: t("auth.registrations.new.eyebrow"),
    title: t("auth.registrations.new.heading"),
    description: t("auth.registrations.new.subheading"),
    alternate_prompt: t("auth.registrations.new.sign_in_prompt"),
    alternate_label: t("auth.registrations.new.sign_in_link"),
    alternate_path: new_session_path
  )
%>

<% auth_shell.with_panel do %>
  <%= form_with url: registration_path, scope: :registration, class: "space-y-5" do |form| %>
    <div class="auth-form__intro">
      <p class="auth-form__heading"><%= t("auth.registrations.new.card_heading") %></p>
      <p class="auth-form__supporting"><%= t("auth.registrations.new.card_supporting") %></p>
    </div>

    <div class="space-y-1.5">
      <%= form.label :email, t("auth.fields.email"), class: "auth-form__label" %>
      <%= form.email_field :email, value: params.dig(:registration, :email), autocomplete: "email", class: "auth-form__input", placeholder: t("auth.fields.email_placeholder") %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password, t("auth.fields.password"), class: "auth-form__label" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "auth-form__input", placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password_confirmation, t("auth.fields.password_confirmation"), class: "auth-form__label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "auth-form__input", placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :locale, t("auth.fields.locale"), class: "auth-form__label" %>
      <%= form.select :locale, I18n.available_locales.map { |locale| [ t("auth.locales.#{locale}"), locale ] }, { selected: params.dig(:registration, :locale) || I18n.default_locale }, class: "auth-form__select" %>
      <p class="auth-form__supporting"><%= t("auth.registrations.new.locale_hint") %></p>
    </div>

    <% if @errors.present? %>
      <div class="auth-form__error" role="alert">
        <%= @errors.to_h.values.flatten.join(", ") %>
      </div>
    <% end %>

    <%= form.submit t("auth.registrations.new.submit"), class: "auth-form__submit" %>
  <% end %>
<% end %>

<%= render auth_shell %>
