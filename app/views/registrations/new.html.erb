<% content_for :title, t("auth.registrations.new.title") %>

<div class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold"><%= t("auth.registrations.new.heading") %></h1>
  <p class="mt-2 text-sm text-slate-600"><%= t("auth.registrations.new.subheading") %></p>

  <%= form_with url: registration_path, scope: :registration, class: "mt-8 space-y-4" do |form| %>
    <div>
      <%= form.label :email, t("auth.fields.email"), class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, value: params.dig(:registration, :email), autocomplete: "email", class: "w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password, t("auth.fields.password"), class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password_confirmation, t("auth.fields.password_confirmation"), class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :locale, t("auth.fields.locale"), class: "mb-1 block text-sm font-medium" %>
      <%= form.select :locale, I18n.available_locales.map { |locale| [ locale.to_s.upcase, locale ] }, { selected: params.dig(:registration, :locale) || I18n.default_locale }, class: "w-full rounded border px-3 py-2" %>
    </div>

    <% if @errors.present? %>
      <div class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        <%= @errors.to_h.values.flatten.join(", ") %>
      </div>
    <% end %>

    <%= form.submit t("auth.registrations.new.submit"), class: "w-full rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <p class="mt-4 text-sm text-slate-600">
    <%= t("auth.registrations.new.sign_in_prompt") %>
    <%= link_to t("auth.registrations.new.sign_in_link"), new_session_path, class: "font-medium text-slate-900 underline" %>
  </p>
</div>
