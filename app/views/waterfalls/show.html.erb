<% content_for :title, @waterfall.spot.name %>

<% spot = @waterfall.spot %>

<div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <div class="space-y-3">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-slate-500"><%= spot.region.name %></p>
    <h1 class="text-3xl font-semibold text-slate-900"><%= spot.name %></h1>

    <% if spot.summary.present? %>
      <p class="text-lg text-slate-700"><%= spot.summary %></p>
    <% end %>
  </div>

  <% if spot.description.present? %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="leading-7 text-slate-700"><%= spot.description %></p>
    </div>
  <% end %>

  <dl class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
    <% if @waterfall.height_meters.present? %>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t("waterfalls.show.height_label") %></dt>
        <dd class="mt-1 text-base text-slate-900"><%= t("waterfalls.shared.height", value: @waterfall.height_meters) %></dd>
      </div>
    <% end %>

    <% if @waterfall.flow_seasonality.present? %>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t("waterfalls.show.flow_seasonality_label") %></dt>
        <dd class="mt-1 text-base text-slate-900"><%= @waterfall.flow_seasonality.humanize %></dd>
      </div>
    <% end %>

    <% if @waterfall.approach_difficulty.present? %>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t("waterfalls.show.approach_difficulty_label") %></dt>
        <dd class="mt-1 text-base text-slate-900"><%= @waterfall.approach_difficulty.humanize %></dd>
      </div>
    <% end %>

    <div>
      <dt class="text-sm font-medium text-slate-500"><%= t("waterfalls.show.plunge_pool_label") %></dt>
      <dd class="mt-1 text-base text-slate-900">
        <%= @waterfall.plunge_pool? ? t("waterfalls.show.plunge_pool_yes") : t("waterfalls.show.plunge_pool_no") %>
      </dd>
    </div>
  </dl>

  <div>
    <%= link_to t("waterfalls.show.back"), waterfalls_path, class: "text-sm font-medium text-sky-700 hover:text-sky-800" %>
  </div>
</div>
