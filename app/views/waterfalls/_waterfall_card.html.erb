<% spot = waterfall.spot %>
<% point = spot.location %>
<% card_surface_class ||= "group rounded-[1.35rem] border border-white/80 bg-white/95 p-4 shadow-[0_18px_50px_rgba(15,23,42,0.1)] transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-[0_28px_80px_rgba(15,23,42,0.14)] focus-within:border-emerald-300 focus-within:ring-2 focus-within:ring-emerald-200 backdrop-blur" %>

<%= content_tag :article,
                class: card_surface_class,
                data: {
                  action: "click->explore-map#cardSelected",
                  explore_map_target: "card",
                  public_id: spot.public_id,
                  search_text: [ spot.name, spot.summary, spot.region.name, waterfall.approach_difficulty ].compact.join(" ").downcase,
                  longitude: point.longitude,
                  latitude: point.latitude
                } do %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1 space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <p class="rounded-full bg-stone-100 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-emerald-900/65"><%= spot.region.name %></p>
        <% if waterfall.approach_difficulty.present? %>
          <span class="rounded-full bg-emerald-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-emerald-900"><%= waterfall.approach_difficulty.humanize %></span>
        <% end %>
      </div>

      <h2 class="font-serif text-2xl leading-tight text-slate-950">
        <%= link_to spot.name, waterfall_path(spot), class: "block transition group-hover:text-emerald-900" %>
      </h2>

      <% if spot.summary.present? %>
        <p class="line-clamp-2 text-sm leading-6 text-slate-600"><%= spot.summary %></p>
      <% end %>
    </div>

    <% if waterfall.height_meters.present? %>
      <span class="shrink-0 rounded-full bg-emerald-950 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-50">
        <%= t("waterfalls.shared.height", value: waterfall.height_meters) %>
      </span>
    <% end %>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-slate-600">
    <% if waterfall.plunge_pool? %>
      <span class="rounded-full bg-sky-50 px-3 py-1 text-sky-800"><%= t("waterfalls.index.filters.plunge_pool_yes") %></span>
    <% end %>
  </div>

  <div class="mt-5 flex items-center justify-between gap-3 border-t border-stone-200/80 pt-4">
    <span class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-slate-400"><%= t("waterfalls.index.list_mode") %></span>

    <div class="flex items-center gap-2">
      <%= button_tag(
            t("waterfalls.index.actions.locate"),
            type: :button,
            class: "inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-emerald-900 transition hover:border-emerald-300 hover:bg-emerald-100",
            data: { action: "explore-map#focusCard", public_id: spot.public_id }
          ) %>

      <%= link_to t("waterfalls.index.actions.details"), waterfall_path(spot), class: "inline-flex items-center gap-2 rounded-full px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-slate-600 transition hover:bg-stone-100 hover:text-slate-950" %>
    </div>
  </div>
<% end %>
