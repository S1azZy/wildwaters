<% content_for :title, t("waterfalls.index.title") %>
<% content_for :main_class, "flex w-full min-h-0 p-0" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl", "data-turbo-track": "reload" %>
<% end %>
<%
  map_style_id = ->(map_style) { map_style.respond_to?(:fetch) ? map_style.fetch(:id) : map_style.id }
  map_style_name = ->(map_style) { map_style.respond_to?(:fetch) ? map_style.fetch(:name) : map_style.name }
  map_style_url = ->(map_style) { map_style.respond_to?(:fetch) ? map_style.fetch(:style_url) : map_style.style_url }
  map_styles = Array(@map_styles).presence || [
    {
      id: "outdoors",
      name: t("waterfalls.index.map_styles.outdoors"),
      style_url: "https://tiles.stadiamaps.com/styles/outdoors.json"
    },
    {
      id: "liberty",
      name: t("waterfalls.index.map_styles.liberty"),
      style_url: "https://tiles.openfreemap.org/styles/liberty"
    },
    {
      id: "bright",
      name: t("waterfalls.index.map_styles.bright"),
      style_url: "https://tiles.openfreemap.org/styles/bright"
    },
    {
      id: "positron",
      name: t("waterfalls.index.map_styles.positron"),
      style_url: "https://tiles.openfreemap.org/styles/positron"
    }
  ]
  default_map_style_id = @default_map_style_id.presence || map_style_id.call(map_styles.first)

  region_options = [ [ t("waterfalls.index.filters.all_regions"), nil ] ]
  region_options += @regions.map { |region| [ region.name, region.public_id ] }

  plunge_pool_options = [
    [ t("waterfalls.index.filters.any_plunge_pool"), nil ],
    [ t("waterfalls.index.filters.plunge_pool_yes"), true ],
    [ t("waterfalls.index.filters.plunge_pool_no"), false ]
  ]

  difficulty_options = [
    [ t("waterfalls.index.filters.any_difficulty"), nil ],
    [ t("waterfalls.index.filters.easy"), "easy" ],
    [ t("waterfalls.index.filters.moderate"), "moderate" ],
    [ t("waterfalls.index.filters.hard"), "hard" ]
  ]
  waterfall_card_class = "group rounded-[1.35rem] border border-white/80 bg-white/95 p-4 shadow-[0_18px_50px_rgba(15,23,42,0.1)] transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-[0_28px_80px_rgba(15,23,42,0.14)] focus-within:border-emerald-300 focus-within:ring-2 focus-within:ring-emerald-200 backdrop-blur"
%>

<%= content_tag :section,
                id: "explore-home",
                class: "explore-layout-shell flex w-full flex-1 flex-col",
                data: {
                  controller: "explore-map",
                  explore_map_map_data_url_value: map_data_waterfalls_path,
                  explore_map_map_style_url_value: map_style_url.call(map_styles.first),
                  explore_map_default_style_id_value: default_map_style_id,
                  explore_map_initial_longitude_value: "115.1889",
                  explore_map_initial_latitude_value: "-8.2601",
                  explore_map_initial_zoom_value: "7.4",
                  explore_map_loading_label_value: t("waterfalls.index.loading"),
                  explore_map_list_hint_value: t("waterfalls.index.list_hint"),
                  explore_map_list_mode_value: t("waterfalls.index.list_mode"),
                  explore_map_panel_open_class_value: "is-expanded",
                  explore_map_empty_label_value: t("waterfalls.index.empty"),
                  explore_map_locate_label_value: t("waterfalls.index.actions.locate"),
                  explore_map_details_label_value: t("waterfalls.index.actions.details"),
                  explore_map_map_unavailable_label_value: t("waterfalls.index.map_unavailable"),
                  explore_map_style_preference_key_value: "wildwaters:explore-map-style",
                  explore_map_visible_label_value: t("waterfalls.index.visible_label")
                } do %>
  <div class="explore-filter-band border-b border-stone-200/70 bg-white/92 px-4 py-2.5 shadow-[0_8px_24px_rgba(15,23,42,0.03)] backdrop-blur" data-explore-map-target="controlsPanel">
    <div class="explore-filter-row mx-auto flex w-full flex-col gap-3 xl:grid xl:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto] xl:items-center xl:gap-3" data-desktop-layout="single-row">
      <div class="explore-filter-search min-w-0">
        <%= label_tag :explore_search, t("waterfalls.index.filters.search"), class: "sr-only" %>
        <%= search_field_tag :explore_search, nil, id: :explore_search, placeholder: t("waterfalls.index.filters.search_placeholder"), autocomplete: "off", class: "w-full rounded-full border border-stone-200 bg-white px-4 py-[0.82rem] text-[0.93rem] text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100", data: { explore_map_target: "search", action: "input->explore-map#searchChanged" } %>
      </div>

      <%= form_with url: waterfalls_path, method: :get, scope: nil, class: "explore-filter-form grid gap-3 md:grid-cols-2 xl:min-w-0 xl:grid-cols-[repeat(4,minmax(0,1fr))_auto] xl:items-center", data: { explore_map_target: "filters", action: "input->explore-map#filtersChanged change->explore-map#filtersChanged submit->explore-map#filtersChanged", desktop_wrap: "never" } do %>
        <div class="explore-filter-field grid gap-2 min-w-0">
          <%= label_tag :region_public_id, t("waterfalls.index.filters.region"), class: "sr-only" %>
          <%= select_tag(
                :region_public_id,
                options_for_select(region_options, @filters[:region_public_id]),
                class: "w-full rounded-full border border-stone-200 bg-white px-4 py-[0.82rem] text-[0.93rem] text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100"
              ) %>
        </div>

        <div class="explore-filter-field grid gap-2 min-w-0">
          <%= label_tag :min_height_meters, t("waterfalls.index.filters.min_height"), class: "sr-only" %>
          <%= number_field_tag :min_height_meters, @filters[:min_height_meters], min: 0, step: 5, placeholder: t("waterfalls.index.filters.min_height_placeholder"), autocomplete: "off", class: "w-full rounded-full border border-stone-200 bg-white px-4 py-[0.82rem] text-[0.93rem] text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" %>
        </div>

        <div class="explore-filter-field grid gap-2 min-w-0">
          <%= label_tag :plunge_pool, t("waterfalls.index.filters.plunge_pool"), class: "sr-only" %>
          <%= select_tag(
                :plunge_pool,
                options_for_select(plunge_pool_options, @filters[:plunge_pool]),
                class: "w-full rounded-full border border-stone-200 bg-white px-4 py-[0.82rem] text-[0.93rem] text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100"
              ) %>
        </div>

        <div class="explore-filter-field grid gap-2 min-w-0">
          <%= label_tag :approach_difficulty, t("waterfalls.index.filters.approach_difficulty"), class: "sr-only" %>
          <%= select_tag(
                :approach_difficulty,
                options_for_select(difficulty_options, @filters[:approach_difficulty]),
                class: "w-full rounded-full border border-stone-200 bg-white px-4 py-[0.82rem] text-[0.93rem] text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100"
              ) %>
        </div>

        <div class="explore-filter-actions flex items-center gap-2.5 whitespace-nowrap">
          <%= submit_tag t("waterfalls.index.filters.apply"), class: "inline-flex min-h-[2.85rem] cursor-pointer items-center justify-center rounded-full bg-emerald-950 px-4 text-[0.92rem] font-semibold text-white transition hover:bg-emerald-900" %>
          <%= link_to t("waterfalls.index.filters.reset"), waterfalls_path, class: "inline-flex min-h-[2.85rem] items-center justify-center rounded-full border border-stone-300 bg-white px-4 text-[0.92rem] font-medium text-slate-700 transition hover:border-slate-400 hover:text-slate-950" %>
        </div>
      <% end %>

      <div class="explore-filter-utility flex items-center gap-2.5 xl:justify-self-end">
        <details class="explore-map-style-menu relative" data-explore-map-target="styleMenu">
          <summary class="explore-map-style-toggle flex min-h-[2.85rem] cursor-pointer list-none items-center gap-2.5 rounded-full border border-stone-200 bg-white px-4 text-slate-900 shadow-[0_8px_20px_rgba(15,23,42,0.06)] transition hover:border-stone-300">
            <span class="explore-map-style-toggle-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="text-[0.92rem] font-semibold tracking-[0.01em] text-slate-800"><%= t("waterfalls.index.map_styles.menu_label") %></span>
          </summary>

          <div class="explore-map-style-panel absolute right-0 top-[calc(100%+0.9rem)] z-20 w-[min(22rem,calc(100vw-2.5rem))] rounded-[1.5rem] border border-stone-200 bg-white/98 p-5 text-slate-900 shadow-[0_28px_90px_rgba(15,23,42,0.22)]">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500"><%= t("waterfalls.index.map_styles.panel_heading") %></p>

            <div class="grid grid-cols-2 gap-4">
              <% map_styles.each do |map_style| %>
                <button
                  type="button"
                  class="explore-map-style-option group text-left transition"
                  data-action="explore-map#switchStyle"
                  data-explore-map-target="styleButton"
                  data-style-id="<%= map_style_id.call(map_style) %>"
                  data-style-url="<%= map_style_url.call(map_style) %>">
                  <span class="explore-map-style-preview explore-map-style-preview--<%= map_style_id.call(map_style) %>">
                    <span class="explore-map-style-preview-inner"></span>
                  </span>
                  <span class="mt-2 block text-lg font-semibold leading-tight text-slate-800"><%= map_style_name.call(map_style) %></span>
                </button>
              <% end %>
            </div>
          </div>
        </details>

        <button type="button" class="explore-results-toggle inline-flex min-h-[2.85rem] items-center justify-center rounded-full border px-4 text-[0.92rem] font-semibold transition hover:border-stone-300" data-action="explore-map#toggleResults" data-explore-map-target="resultsToggle" aria-expanded="false" aria-controls="explore-results-panel">
          <%= t("waterfalls.index.list_heading") %>
        </button>
      </div>
    </div>
  </div>

  <div class="explore-map-shell explore-map-shell--full-bleed explore-map-shell--viewport-fit relative flex-1 overflow-hidden" data-explore-map-target="shell">
    <div class="explore-map-surface absolute inset-0">
      <div class="h-full w-full explore-map-canvas" data-explore-map-target="canvas"></div>
    </div>

    <aside id="explore-results-panel" class="explore-results-overlay is-collapsed absolute inset-x-3 top-3 z-20 flex max-h-[calc(100%-1.5rem)] flex-col overflow-hidden rounded-[1.6rem] backdrop-blur sm:inset-x-4 sm:top-4 lg:left-5 lg:top-5 lg:w-[24rem] lg:max-h-[calc(100%-2.5rem)] lg:inset-x-auto" data-explore-map-target="resultsPanel">
      <div class="border-b border-stone-200/90 px-5 pb-4 pt-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="space-y-2">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-emerald-900/55"><%= t("waterfalls.index.eyebrow") %></p>
            <div class="space-y-2">
              <h1 class="max-w-sm font-serif text-3xl leading-none text-slate-950 sm:text-[2.45rem]"><%= t("waterfalls.index.heading") %></h1>
              <p class="max-w-md text-sm leading-6 text-slate-600"><%= t("waterfalls.index.subheading") %></p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <p class="rounded-full bg-stone-900 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-50 shadow-[0_12px_30px_rgba(15,23,42,0.18)]">
              <span data-explore-map-target="resultCount"><%= @waterfalls.size %></span>
              <%= t("waterfalls.index.result_suffix") %>
            </p>
            <button type="button" class="inline-flex items-center rounded-full border border-stone-200 bg-white px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-slate-600 transition hover:border-stone-300 hover:text-slate-950" data-action="explore-map#toggleResults">
              <%= t("waterfalls.index.actions.details") %>
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-b border-stone-200/90 px-5 py-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500"><%= t("waterfalls.index.list_heading") %></p>
          <p class="mt-1 text-sm text-slate-500" data-explore-map-target="status" aria-live="polite"><%= t("waterfalls.index.list_hint") %></p>
        </div>

        <div class="flex items-center gap-2">
          <span class="hidden rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-emerald-900" data-explore-map-target="loading"><%= t("waterfalls.index.loading") %></span>
          <span class="rounded-full bg-stone-100 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-slate-500"><%= t("waterfalls.index.list_mode") %></span>
        </div>
      </div>

      <div class="explore-scrollbar flex-1 overflow-y-auto px-4 py-4">
        <div class="grid gap-4" data-explore-map-target="list" data-card-class-template="<%= waterfall_card_class %>" aria-live="polite">
          <%= render partial: "waterfall_card", collection: @waterfalls, as: :waterfall, locals: { card_surface_class: waterfall_card_class } %>
        </div>

        <p class="hidden rounded-[1.75rem] border border-dashed border-stone-300 bg-white/80 px-5 py-8 text-center text-sm leading-6 text-slate-500" data-explore-map-target="empty">
          <%= t("waterfalls.index.empty") %>
        </p>
      </div>
    </aside>

    <div class="pointer-events-none absolute inset-x-4 top-32 z-20 hidden justify-center sm:top-36" data-explore-map-target="mapState">
      <div class="max-w-sm rounded-full border border-white/18 bg-black/35 px-4 py-3 text-center text-sm leading-6 text-white/86 shadow-[0_18px_80px_rgba(0,0,0,0.28)] backdrop-blur"></div>
    </div>

    <noscript>
      <div class="absolute inset-x-4 bottom-4 z-20 rounded-[1.5rem] border border-white/15 bg-black/35 px-4 py-4 text-sm leading-6 text-white/84 shadow-[0_18px_80px_rgba(0,0,0,0.28)]">
        <%= t("waterfalls.index.no_javascript") %>
      </div>
    </noscript>
  </div>
<% end %>
