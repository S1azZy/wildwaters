<% content_for :title, t("dashboard.show.title") %>

<div class="mx-auto w-full max-w-2xl">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("dashboard.show.heading") %></h1>
      <p class="mt-2 text-sm text-slate-600">
        <%= t("dashboard.show.signed_in_as", email: current_user.primary_email) %>
      </p>
    </div>

    <%= button_to t("dashboard.show.sign_out"), session_path, method: :delete, class: "rounded border px-4 py-2 text-sm font-medium" %>
  </div>
</div>
