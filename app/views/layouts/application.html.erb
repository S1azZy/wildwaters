<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wildwaters" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wildwaters">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen text-neutral-900 antialiased">
    <div class="site-shell">
      <%= render Ui::SiteHeaderComponent.new(
            labels: {
              brand_name: t("layouts.header.brand_name"),
              brand_tagline: t("layouts.header.brand_tagline"),
              explore: t("layouts.header.explore"),
              info: t("layouts.header.info"),
              dashboard: t("layouts.header.dashboard"),
              sign_in: t("layouts.header.sign_in"),
              create_account: t("layouts.header.create_account"),
              sign_out: t("layouts.header.sign_out")
            },
            current_path: request.fullpath,
            authenticated: authenticated?,
            explore_path: root_path,
            info_path: root_path(anchor: "about"),
            dashboard_path: dashboard_path,
            sign_in_path: new_session_path,
            registration_path: new_registration_path,
            session_path: session_path
          ) %>

      <main class="<%= content_for?(:main_class) ? yield(:main_class) : "mx-auto w-full max-w-[112rem] px-4 py-6 sm:px-6 lg:px-8" %>">
        <% if flash.any? %>
          <div class="mx-auto mb-6 w-full max-w-2xl space-y-2 px-4 sm:px-0">
          <% flash.each do |type, message| %>
            <div class="rounded border px-4 py-3 text-sm <%= type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700" %>">
              <%= message %>
            </div>
          <% end %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
