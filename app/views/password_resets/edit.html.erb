<% content_for :title, t("auth.password_resets.edit.title") %>
<% content_for :main_class, "auth-main flex-1 px-0 py-0" %>
<% content_for :body_class, "auth-page auth-page--recovery" %>

<%
  auth_shell = Ui::AuthShellComponent.new(
    variant: :recovery,
    eyebrow: t("auth.password_resets.edit.eyebrow"),
    title: t("auth.password_resets.edit.heading"),
    description: t("auth.password_resets.edit.subheading"),
    alternate_prompt: t("auth.password_resets.edit.sign_in_prompt"),
    alternate_label: t("auth.password_resets.edit.sign_in_link"),
    alternate_path: new_session_path,
    footer_author: t("auth.shared.footer.author"),
    footer_note: t("auth.shared.footer.note")
  )
%>

<% auth_shell.with_panel do %>
  <%= form_with url: password_reset_token_path(@token), scope: :password_reset, method: :patch, class: "space-y-5" do |form| %>
    <div class="auth-form__intro">
      <p class="auth-form__heading"><%= t("auth.password_resets.edit.card_heading") %></p>
      <p class="auth-form__supporting"><%= t("auth.password_resets.edit.card_supporting") %></p>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password, t("auth.fields.password"), class: "auth-form__label" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "auth-form__input", placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password_confirmation, t("auth.fields.password_confirmation"), class: "auth-form__label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "auth-form__input", placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <%= form.submit t("auth.password_resets.edit.submit"), class: "auth-form__submit" %>
  <% end %>
<% end %>

<%= render auth_shell %>
