<% content_for :title, t("auth.password_resets.new.title") %>
<% content_for :main_class, "auth-main flex-1 px-0 py-0" %>
<% content_for :body_class, "auth-page auth-page--recovery" %>

<%
  auth_shell = Ui::AuthShellComponent.new(
    variant: :recovery,
    eyebrow: t("auth.password_resets.new.eyebrow"),
    title: t("auth.password_resets.new.heading"),
    description: t("auth.password_resets.new.subheading"),
    alternate_prompt: t("auth.password_resets.new.sign_in_prompt"),
    alternate_label: t("auth.password_resets.new.sign_in_link"),
    alternate_path: new_session_path
  )
%>

<% auth_shell.with_panel do %>
  <%= form_with url: password_reset_path, scope: :password_reset, class: "space-y-5" do |form| %>
    <div class="auth-form__intro">
      <p class="auth-form__heading"><%= t("auth.password_resets.new.card_heading") %></p>
      <p class="auth-form__supporting"><%= t("auth.password_resets.new.card_supporting") %></p>
    </div>

    <div class="space-y-1.5">
      <%= form.label :email, t("auth.fields.email"), class: "auth-form__label" %>
      <%= form.email_field :email, value: params.dig(:password_reset, :email), autocomplete: "email", class: "auth-form__input", placeholder: t("auth.fields.email_placeholder") %>
    </div>

    <%= form.submit t("auth.password_resets.new.submit"), class: "auth-form__submit" %>
  <% end %>
<% end %>

<%= render auth_shell %>
