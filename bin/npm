#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v asdf >/dev/null 2>&1; then
  ASDF_NODE="$(asdf which node 2>/dev/null || true)"

  if [ -n "${ASDF_NODE}" ]; then
    export PATH="$(dirname "${ASDF_NODE}"):${PATH}"
  fi
fi

cd "${ROOT_DIR}"
exec npm "$@"
